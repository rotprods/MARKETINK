{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MARKET.INK Verified Case Study Evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "client_type",
    "permission",
    "period",
    "baseline",
    "interventions",
    "results",
    "measurement",
    "evidence_refs",
    "status"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^CASE-MKTINK-[0-9]{4}-[0-9]{4}$"
    },
    "client_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "public_client_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "client_type": {
      "type": "string",
      "enum": [
        "studio",
        "independent_artist"
      ]
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_use",
        "testimonial_use",
        "logo_use",
        "approved_at"
      ],
      "properties": {
        "public_use": {
          "type": "boolean"
        },
        "testimonial_use": {
          "type": "boolean"
        },
        "logo_use": {
          "type": "boolean"
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "period": {
      "type": "object",
      "required": [
        "baseline_start",
        "baseline_end",
        "intervention_start",
        "measurement_end"
      ],
      "properties": {
        "baseline_start": {
          "type": "string",
          "format": "date"
        },
        "baseline_end": {
          "type": "string",
          "format": "date"
        },
        "intervention_start": {
          "type": "string",
          "format": "date"
        },
        "measurement_end": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "null"
        ]
      }
    },
    "interventions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "started_at",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "started_at": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string"
          },
          "controlled_by_marketink": {
            "type": "boolean"
          }
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "metric",
          "baseline_value",
          "result_value",
          "verified"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "baseline_value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "result_value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "attribution_strength": {
            "type": "string",
            "enum": [
              "DIRECT",
              "STRONG",
              "PARTIAL",
              "CORRELATIONAL",
              "UNKNOWN"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "measurement": {
      "type": "object",
      "required": [
        "method",
        "limitations"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_systems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "testimonial": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "speaker": {
          "type": "string"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ref": {
          "type": "string"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "claims_allowed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims_forbidden": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "VERIFICATION",
        "APPROVED",
        "REJECTED",
        "EXPIRED"
      ]
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
